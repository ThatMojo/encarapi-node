{
  "name": "encarapi",
  "version": "1.0.0",
  "description": "Official Node.js client for EnCarAPI: Korean used car data (Encar, KB Chachacha, K Car) and Chinese used car data (Dongchedi, Che168) in one REST API.",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node test/smoke.js",
    "test:live": "node test/smoke.js --live"
  },
  "keywords": [
    "encar",
    "encar api",
    "encar.com",
    "kbchacha",
    "kb chachacha",
    "kcar",
    "k car",
    "korean car api",
    "korea car api",
    "korean used car data",
    "china car api",
    "chinese used car data",
    "che168",
    "dongchedi",
    "car export",
    "vehicle data api"
  ],
  "homepage": "https://encarapi.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThatMojo/encarapi-node.git"
  },
  "bugs": {
    "url": "https://github.com/ThatMojo/encarapi-node/issues"
  },
  "author": "EnCarAPI (https://encarapi.com)",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
